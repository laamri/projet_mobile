<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lab 22 : JNI Interactive"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:paddingBottom="8dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvHello"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:paddingBottom="24dp"
            android:textStyle="italic" />

        <!-- Zone Interactive -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TESTS INTERACTIFS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#757575"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Factoriel Dynamique"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etFactorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Entrez n (ex: 5)"
                    android:inputType="numberSigned" />

                <Button
                    android:id="@+id/btnCalcFact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calculer (JNI)" />

                <TextView
                    android:id="@+id/tvFactResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Résultat : -"
                    android:paddingTop="8dp"
                    android:textColor="#4CAF50" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Inversion de Chaîne"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etReverse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Texte à inverser" />

                <Button
                    android:id="@+id/btnDoReverse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inverser (JNI)" />

                <TextView
                    android:id="@+id/tvReverseResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Résultat : -"
                    android:paddingTop="8dp"
                    android:textColor="#FF9800" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Rapport Automatique -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TESTS GUIDÉS (ÉTAPE 10)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#757575"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">
            <TextView
                android:id="@+id/tvTestReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#37474F" />
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnRunTests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Relancer l'autotest"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>
</ScrollView>